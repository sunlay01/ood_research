{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "verdict", "summary", "checks", "blocking_actions"],
  "properties": {
    "gate": {
      "type": "string",
      "enum": ["DESIGN_GATE", "MVP_GATE", "CODE_GATE", "RESULT_GATE"]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "VETO", "REVISE_ONCE"]
    },
    "summary": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "UNCLEAR"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "blocking_actions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
